{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "**/*.ts",
    "../../../../.sfdx/typings/lwc/**/*.d.ts",
    "../../../../types/**/*.d.ts"
  ],
  "exclude": [
